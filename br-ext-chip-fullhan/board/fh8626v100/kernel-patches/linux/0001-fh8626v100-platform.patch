 EXTRA_CFLAGS      	+= -Iarch/arm/mach-fh/$(CONFIG_FH_CHIP_NAME)
 
-obj-y	+= pmu.o fullhan.o fh_common.o fh_chipid.o
+obj-y	+= fullhan.o fh_common.o fh_chipid.o
