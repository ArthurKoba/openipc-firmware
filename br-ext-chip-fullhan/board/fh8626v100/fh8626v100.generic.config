CONFIG_TINY_KERNEL=y
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_KERNEL_XZ=y
# CONFIG_SWAP is not set
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
# CONFIG_FHANDLE is not set
CONFIG_USELIB=y
# CONFIG_IRQ_DOMAIN_DEBUG is not set
CONFIG_LOG_BUF_SHIFT=16
# CONFIG_SCHED_DL is not set
CONFIG_BLK_DEV_INITRD=y
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_LD_DEAD_CODE_DATA_ELIMINATION=y
CONFIG_EXPERT=y
# CONFIG_BUG is not set
# CONFIG_ELF_CORE is not set
# CONFIG_VM_EVENT_COUNTERS is not set
# CONFIG_SLUB_DEBUG is not set
CONFIG_JUMP_LABEL=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# CONFIG_LBDAF is not set
# CONFIG_BLK_DEV_BSG is not set
# CONFIG_IOSCHED_DEADLINE is not set
CONFIG_ARCH_FULLHAN=y
CONFIG_ARCH_FH8626V100=y
CONFIG_MACH_FH8626V100=y
# Keep the on-chip RTC platform device opt-in. The shared driver remains
# available, but a board profile must enable the device only after its RTC
# clock/backup-domain path has been validated on hardware.
# CONFIG_FH8626V100_ONCHIP_RTC is not set
# CONFIG_FH_TSENSOR is not set
# CONFIG_USE_TSENSOR is not set
# CONFIG_USE_TSENSOR_OFFSET is not set
# CONFIG_RTC_HCTOSYS is not set
# CONFIG_RTC_SYSTOHC is not set
CONFIG_ARM_ERRATA_411920=y
CONFIG_AEABI=y
CONFIG_AUTO_ZRELADDR=y
CONFIG_VFP=y
# CONFIG_SUSPEND is not set
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IP_MULTICAST=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_DNS_RESOLVER=y
CONFIG_CFG80211=y
# CONFIG_CFG80211_DEFAULT_PS is not set
CONFIG_CFG80211_WEXT=y
CONFIG_RFKILL=y
CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_M25P80=y
CONFIG_MTD_SPI_NOR=y
# CONFIG_MTD_SPI_NOR_USE_4K_SECTORS is not set
# CONFIG_BLK_DEV is not set
CONFIG_FH_SADC_V2=y
CONFIG_FH_SADC_V21=y
CONFIG_FH_EFUSE=y
# Keep the Fullhan pinctrl misc interface available to board bootstrap code
# without baking any retail-camera GPIO policy into the generic SoC config.
CONFIG_FH_PINCTRL_MISC_DEV=y
# The vendor clock-control miscdev is not part of the production userspace ABI.
# Kernel drivers use the clock framework directly; board/Divinus code has no
# fh_clk miscdev dependency.
# CONFIG_FH_CLK_MISC is not set
CONFIG_NETDEVICES=y
# CONFIG_NET_VENDOR_AMAZON is not set
# CONFIG_NET_VENDOR_ARC is not set
# CONFIG_NET_CADENCE is not set
# CONFIG_NET_VENDOR_BROADCOM is not set
# CONFIG_NET_VENDOR_CIRRUS is not set
# CONFIG_NET_VENDOR_EZCHIP is not set
# CONFIG_NET_VENDOR_FARADAY is not set
# CONFIG_NET_VENDOR_INTEL is not set
# CONFIG_NET_VENDOR_MARVELL is not set
# CONFIG_NET_VENDOR_MICREL is not set
# CONFIG_NET_VENDOR_MICROCHIP is not set
# CONFIG_NET_VENDOR_NATSEMI is not set
# CONFIG_NET_VENDOR_NETRONOME is not set
# CONFIG_NET_VENDOR_QUALCOMM is not set
# CONFIG_NET_VENDOR_RENESAS is not set
# CONFIG_NET_VENDOR_ROCKER is not set
# CONFIG_NET_VENDOR_SAMSUNG is not set
# CONFIG_NET_VENDOR_SEEQ is not set
# CONFIG_NET_VENDOR_SMSC is not set
# CONFIG_NET_VENDOR_STMICRO is not set
# CONFIG_NET_VENDOR_SYNOPSYS is not set
# CONFIG_NET_VENDOR_VIA is not set
# CONFIG_NET_VENDOR_WIZNET is not set
CONFIG_FH_GMAC=y
CONFIG_FH_GMAC_DA=y
CONFIG_FIXED_PHY=y
# Legacy Prism2/2.5/3 Host AP support is unrelated to board-selected USB Wi-Fi.
# CONFIG_HOSTAP is not set
# CONFIG_INPUT_MOUSEDEV is not set
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_SERIO is not set
# CONFIG_LEGACY_PTYS is not set
# CONFIG_DEVKMEM is not set
CONFIG_SERIAL_FULLHAN=y
# CONFIG_HW_RANDOM is not set
CONFIG_I2C=y
# CONFIG_I2C_COMPAT is not set
CONFIG_I2C_CHARDEV=y
# CONFIG_I2C_HELPER_AUTO is not set
CONFIG_I2C_FH_INTERRUPT=y
CONFIG_SPI=y
CONFIG_SPI_FH=y
CONFIG_SPI_TINY_MEM=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_SYSFS=y
CONFIG_GPIO_FH=y
# CONFIG_HWMON is not set
CONFIG_WATCHDOG=y
CONFIG_FH_WATCHDOG=y
# CONFIG_HID is not set
# CONFIG_USB_HID is not set
CONFIG_USB=y
# CONFIG_USB_ANNOUNCE_NEW_DEVICES is not set
# CONFIG_USB_DYNAMIC_MINORS is not set
# CONFIG_USB_WUSB_CBAF is not set
# CONFIG_USB_WDM is not set
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_VBVALIDOVEN=y
CONFIG_MMC=y
# Retain the generic Fullhan RTC driver; board-specific fragments may override
# the platform-device selection.
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_FH=y
CONFIG_DMADEVICES=y
CONFIG_FH_AXI_DMAC=y
CONFIG_CHANNEL_ALLOC_DESC_NUM=32
# CONFIG_IOMMU_SUPPORT is not set
CONFIG_PWM=y
CONFIG_PWM_FULLHAN=y
CONFIG_VFAT_FS=y
CONFIG_TMPFS=y
CONFIG_CONFIGFS_FS=y
CONFIG_JFFS2_FS=y
# CONFIG_JFFS2_FS_WRITEBUFFER is not set
# The NOR rootfs is immutable SquashFS. In the standard OpenIPC 8 MiB layout,
# the remaining NOR after the 5120 KiB rootfs is rootfs_data and uses JFFS2 as
# the persistent writable upper layer.
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_NFS_FS=y
# CONFIG_NFS_V2 is not set
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_PRINTK_TIME=y
CONFIG_DEBUG_FS=y
CONFIG_OPTIMIZE_INLINING=y
# CONFIG_FTRACE is not set
CONFIG_KEYS=y
CONFIG_CRYPTO_USER=y
CONFIG_CRYPTO_SEQIV=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_DES=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_DEV_FH_AES=y
CONFIG_CRC16=y
