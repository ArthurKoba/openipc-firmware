# Board-only override. The FH8626V100 RTC remains available to other boards.
# AJL33PQ0866 has no suitable RTC clock/backup hardware available for complete
# functional validation. Keep rtc0 disabled until it can be retested on suitable
# hardware; do not disable the shared Fullhan RTC driver for other boards.
# The on-chip TSENSOR is not directly readable MMIO. Its trigger and TEMP_INFO
# read both use the same RTC core command channel that timed out in native and
# exact stock kernels on this board, so keep every TSENSOR path disabled too.
# CONFIG_FH8626V100_ONCHIP_RTC is not set
# CONFIG_FH_TSENSOR is not set
# CONFIG_USE_TSENSOR is not set
# CONFIG_USE_TSENSOR_OFFSET is not set

# AJL33PQ0866 has a stock-proven one-bit SD0 microSD slot. Pad66 remains
# available for its active-low GPIO61 reset button; no SD1 device is present.
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_FH=y
# CONFIG_MMC_FH_IDMAC is not set
CONFIG_FH8626V100_AJL33PQ0866_MMC=y
