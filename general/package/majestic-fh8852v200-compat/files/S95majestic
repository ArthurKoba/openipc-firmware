#!/bin/sh

PID=/var/run/majestic.pid
LOG=/var/log/majestic.log

pid_is_live()
{
	[ -r "$PID" ] || return 1
	pid="$(cat "$PID" 2>/dev/null)"
	[ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

wait_exit()
{
	count=0
	while pid_is_live && [ "$count" -lt 5 ]; do
		sleep 1
		count=$((count + 1))
	done
	! pid_is_live
}

start()
{
	if pid_is_live; then
		return 0
	fi
	rm -f "$PID"

	echo "Starting Majestic FH8626 compatibility control plane"
	/usr/bin/majestic >>"$LOG" 2>&1 &
	pid="$!"
	echo "$pid" > "$PID"

	sleep 1
	if ! kill -0 "$pid" 2>/dev/null; then
		echo "ERROR: Majestic exited during startup; see $LOG" >&2
		rm -f "$PID"
		return 1
	fi
}

stop()
{
	if ! pid_is_live; then
		rm -f "$PID"
		return 0
	fi

	pid="$(cat "$PID")"
	kill "$pid" 2>/dev/null || true
	if ! wait_exit; then
		kill -9 "$pid" 2>/dev/null || true
		sleep 1
	fi

	if pid_is_live; then
		echo "ERROR: Majestic did not stop" >&2
		return 1
	fi
	rm -f "$PID"
}

case "${1:-start}" in
	start) start ;;
	stop) stop ;;
	restart)
		stop
		start
		;;
	*)
		echo "usage: $0 {start|stop|restart}" >&2
		exit 2
		;;
esac
