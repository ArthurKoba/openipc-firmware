config BR2_PACKAGE_MAJESTIC_FH8852V200_COMPAT
	bool "FH8626V100 Majestic FH8852V200 compatibility runtime"
	depends on BR2_arm
	depends on BR2_TOOLCHAIN_USES_MUSL
	select BR2_PACKAGE_JSON_C
	select BR2_PACKAGE_LIBEVENT_OPENIPC
	select BR2_PACKAGE_LIBOGG_OPENIPC
	select BR2_PACKAGE_LIBYAML
	select BR2_PACKAGE_MBEDTLS_OPENIPC
	select BR2_PACKAGE_OPUS_OPENIPC
	select BR2_PACKAGE_OPUS_OPENIPC_FIXED_POINT
	select BR2_PACKAGE_MAJESTIC_WEBUI
	help
	  Experimental FH8626V100 runtime using the FH8852V200 Majestic binary
	  and a staged source compatibility boundary.

	  Default boot remains media-off. Majestic listens on loopback:18080;
	  a source FH8626 HTTP proxy owns port 80, preserves normal HTTP/API/
	  WebSocket traffic and provides the standard /metrics endpoint from
	  Linux /proc data. No WebUI JavaScript patch is used.

	  No FH8852 kernel modules, firmware, load scripts or donor sensor
	  plug-ins are installed.

	  Explicit bring-up runners add source-built FH8626 adapters:
	  - FH8852-shaped GC1054 sensor ABI (0x7c -> native 0x68 callbacks);
	  - FH8852 libdsp surface for recovered SYS/VPSS/VENC operations;
	  - FH8852 libvmm surface for the recovered FH8626 VMM allocator;
	  - FH8626 encoded-stream lease/release -> FH8852 public stream records.

	  The native-video runner is intentionally fixed to the recovered
	  1280x720@25 H.264 Baseline bring-up contract and uses the recovered
	  FH8626 VBR RC and producer-gate sequencing. Unknown/unproved controls
	  remain localized staging stubs.

	  This is compatibility staging, not production-ready Majestic support.
	  Build/runtime/hardware acceptance and donor pinning remain required.
