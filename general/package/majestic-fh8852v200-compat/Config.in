config BR2_PACKAGE_MAJESTIC_FH8852V200_COMPAT
	bool "FH8626V100 Majestic FH8852V200 compatibility runtime"
	depends on BR2_arm
	depends on BR2_TOOLCHAIN_USES_MUSL
	select BR2_PACKAGE_JSON_C
	select BR2_PACKAGE_LIBEVENT_OPENIPC
	select BR2_PACKAGE_LIBOGG_OPENIPC
	select BR2_PACKAGE_LIBYAML
	select BR2_PACKAGE_MBEDTLS_OPENIPC
	select BR2_PACKAGE_OPUS_OPENIPC
	select BR2_PACKAGE_OPUS_OPENIPC_FIXED_POINT
	select BR2_PACKAGE_MAJESTIC_WEBUI
	select BR2_PACKAGE_MAJESTIC_FONTS
	help
	  FH8626V100 compatibility runtime for the FH8852V200 Majestic binary.

	  Majestic HTTP/WebUI is untouched and owns its normal ports directly.
	  The package selects the stock WebUI and Majestic font asset needed by
	  the OSD feature profile.

	  Source compatibility covers the active Fullhan feature closure:
	  GC1054/MIPI, VMM, SYS/VPSS, multi-channel H.264 VENC/RC/stream,
	  JPEG/MJPEG, motion/YCmean, OSD GraphV2 and RTX audio/VQE.

	  Retained donor ISP/ispcore/advapi libraries remain isolated as one
	  coherent userspace ISP context. No FH8852 kernel modules, firmware,
	  load scripts or donor sensor plug-ins are installed.

	  HEVC/H.265 is explicitly unsupported by the stock FH8626 encoder stack;
	  unsupported SDK-only calls are errors, not fake-success stubs.

	  Default boot remains media-off. Manual strict/full-feature runners are
	  provided for target acceptance.
